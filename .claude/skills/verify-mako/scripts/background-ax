#!/bin/bash
# A page opened in the background (Open Link Beneath…, like a middle-click) loads right
# away, its media held until the page is first shown. Accessibility actions only, no focus.
# Prints PASS/FAIL per check; exit status is the number of failures.
set -u
cd "$(dirname "$0")/../../../.."
export MAKO_BACKGROUND=1 MAKO_RUN="$PWD/verify-runs/background-ax"
C=.claude/skills/verify-mako/scripts/control-mako; M=verify-runs/.bin/makoctl
J="$MAKO_RUN/state/trails.json"
fails=0; srv=
check() { local name=$1; shift; if "$@" >/dev/null 2>&1; then echo "PASS $name"; else echo "FAIL $name (titles: $(titles 2>/dev/null))"; fails=$((fails + 1)); fi; }
within() { for _ in $(seq 60); do "$@" >/dev/null 2>&1 && return 0; sleep 0.1; done; return 1; }
titles() { python3 -I -c 'import json, sys; print(sorted(n["title"] for n in json.load(open(sys.argv[1]))["nodes"].values()))' "$J"; }
has_title() { titles | grep -q "'$1'"; }
trap '$C stop >/dev/null 2>&1; [ -n "$srv" ] && { kill $srv 2>/dev/null; wait $srv 2>/dev/null; }' EXIT

$C stop >/dev/null 2>&1
[ "${MAKO_SKIP_BUILD:-}" = 1 ] || $C build >/dev/null || { echo "FAIL build"; exit 99; }
port=$((20000 + RANDOM % 20000)); U="http://127.0.0.1:$port"
python3 -m http.server "$port" --bind 127.0.0.1 -d .claude/skills/verify-mako/fixtures/background >/dev/null 2>&1 &
srv=$!; sleep 1
out=$($C launch "" "$U/index.html" 2>&1) || { echo "FAIL launch: $out"; exit 99; }
P=$($C pid); $M "$P" wait-title Background 10 >/dev/null

$M "$P" menu History "Open Link Beneath…"
within sh -c "$M $P tree 30 | grep -q mako.hint.q"
$M "$P" press-id mako.hint.q
check background-page-loads-before-it-is-shown within has_title "Media loaded"
check opener-stays-shown test "$($M "$P" title)" = Background
sleep 2
check background-page-media-held has_title "Media loaded"
child=$(python3 -I -c 'import json, sys; s = json.load(open(sys.argv[1])); print(max(int(k) for k in s["nodes"]))' "$J")
$M "$P" press-id "mako.trail.$child"
check media-plays-once-shown within has_title "Media playing"

echo "== $fails failure(s); evidence in $MAKO_RUN"
exit "$fails"
